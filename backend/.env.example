# ============================================================
#  TORANO BACKEND - contoh environment
#  Salin ke ".env" lalu isi nilainya. Jangan commit ".env".
# ============================================================

# --- Umum ---
NODE_ENV=development
PORT=5000

# --- Origin frontend yang diizinkan (CORS), dipisah koma ---
CORS_ORIGIN=http://localhost:5173,https://NAMA-SITE.netlify.app

# URL frontend untuk tautan di email
APP_URL=http://localhost:5173

# --- Database: Supabase Session Pooler (IPv4) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Admin panel (login terpisah dari Supabase) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-admin
ADMIN_SECRET=rahasia-acak-panjang

# --- Pembayaran: Midtrans (pakai kunci Sandbox untuk uji) ---
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false

# --- Email: Resend (opsional) ---
RESEND_API_KEY=re_xxxx
EMAIL_FROM=Torano <onboarding@resend.dev>

# --- Web Push / PWA (opsional; buat dengan: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:email@contoh.com
